{
  "name": "manifest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Free, browser-based TCG card scanner. Scan a stack, get a list.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
